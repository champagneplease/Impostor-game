# ========================================================
# VARIABLES DE ENTORNO: JUEGO DEL IMPOSTOR
# ========================================================

# --- BACKEND (Render / Desarrollo Local) ---
# Puerto HTTP en el que corre el servidor Node.js (en Render se inyecta automáticamente por el sistema)
PORT=3001

# Orígenes CORS autorizados separados por coma.
# En desarrollo local: http://localhost:5173
# En producción (Render): la URL pública de tu frontend en Vercel, ej: https://impostor-game.vercel.app
CLIENT_ORIGINS=http://localhost:5173,http://localhost:3000

# Nivel de log (opcional: debug, info, warn, error)
LOG_LEVEL=info

# --- FRONTEND (Vercel / Desarrollo Local) ---
# URL pública del backend de Render para comunicación Socket.IO y health check.
# En desarrollo local: http://localhost:3001
# En producción (Vercel): la URL asignada a tu Web Service en Render, ej: https://impostor-server.onrender.com
VITE_API_URL=http://localhost:3001
