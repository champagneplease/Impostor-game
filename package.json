{
  "name": "impostor-game",
  "version": "1.0.0",
  "private": true,
  "description": "Juego del Impostor - Aplicación web completa y moderna para jugar en dispositivo compartido y multijugador online",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:web": "npm run dev --workspace=@impostor/web",
    "dev:server": "npm run dev --workspace=@impostor/server",
    "build": "npm run build:shared && npm run build:web && npm run build:server",
    "build:shared": "npm run build --workspace=@impostor/shared",
    "build:web": "npm run build --workspace=@impostor/web",
    "build:server": "npm run build --workspace=@impostor/server",
    "test": "npm run test --workspaces --if-present",
    "test:shared": "npm run test --workspace=@impostor/shared",
    "test:server": "npm run test --workspace=@impostor/server",
    "test:web": "npm run test --workspace=@impostor/web",
    "lint": "npm run lint --workspaces --if-present",
    "start:server": "npm run start --workspace=@impostor/server"
  },
  "keywords": [
    "impostor",
    "game",
    "multiplayer",
    "socket.io",
    "react",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "allowScripts": {
    "esbuild": true
  }
}
